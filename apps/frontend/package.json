{
  "name": "@niedax/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --hostname 0.0.0.0 --port 3000",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
