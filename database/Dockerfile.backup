# syntax=docker/dockerfile:1.7
FROM postgres:18.6-alpine3.23@sha256:885cf05d376c7cf27afef02073e6bdac3841252537f16e244fd1c1e6a7c99fb1
RUN rm -f /usr/local/bin/gosu
COPY --chown=postgres:postgres database/scripts/backup.sh /usr/local/bin/niedax-backup
COPY --chown=postgres:postgres database/scripts/reconcile-app-privileges.sql /usr/local/share/niedax-generator/reconcile-app-privileges.sql
USER postgres
ENTRYPOINT ["/bin/sh", "/usr/local/bin/niedax-backup"]
CMD ["list"]
