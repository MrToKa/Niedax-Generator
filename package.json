{
  "name": "niedax-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local modular Docker foundation for Niedax Generator",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "\u003e=24.0.0 \u003c25",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx scripts/compose.ts dev",
    "start": "tsx scripts/compose.ts start",
    "stop": "tsx scripts/compose.ts stop",
    "restart": "tsx scripts/compose.ts restart",
    "status": "tsx scripts/compose.ts status",
    "logs": "tsx scripts/compose.ts logs",
    "access:url": "tsx scripts/show-access-url.ts",
    "build": "corepack pnpm -r --if-present build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit \u0026\u0026 tsc -p tsconfig.tests.json --noEmit \u0026\u0026 corepack pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \u0027**/*.integration.test.ts\u0027",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:containers": "tsx scripts/test-containers.ts",
    "test:runtime-isolation": "tsx scripts/verify-runtime-isolation.ts",
    "test:backup-integration": "tsx scripts/test-backup-integration.ts",
    "stage9:browser": "tsx scripts/stage9-browser-environment.ts",
    "db:migrate": "tsx scripts/database-command.ts up",
    "db:status": "tsx scripts/database-command.ts status",
    "db:seed": "tsx scripts/database-command.ts seed",
    "db:test": "tsx scripts/db-check.ts",
    "db:reset:test": "tsx scripts/db-check.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:new": "tsx database/src/new-migration.ts",
    "user:create-admin": "tsx scripts/create-admin.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:list": "tsx scripts/backup.ts list",
    "backup:verify": "tsx scripts/backup.ts verify",
    "backup:restore": "tsx scripts/backup.ts restore",
    "backup:prune": "tsx scripts/backup.ts prune",
    "catalog:generate": "tsx scripts/generate-stage5-catalog.ts",
    "calculation:golden:update": "corepack pnpm --filter @niedax/domain build \u0026\u0026 tsx scripts/update-stage6-golden.ts",
    "catalog:import": "tsx scripts/catalog-import.ts",
    "catalog:seed:dev": "docker compose exec backend node dist/catalog-seed.js",
    "validate": "corepack pnpm format:check \u0026\u0026 corepack pnpm lint \u0026\u0026 corepack pnpm typecheck \u0026\u0026 corepack pnpm test:unit \u0026\u0026 corepack pnpm build",
    "validate:full": "corepack pnpm validate \u0026\u0026 corepack pnpm db:check \u0026\u0026 docker compose --profile tools build \u0026\u0026 corepack pnpm test:integration \u0026\u0026 corepack pnpm test:containers \u0026\u0026 corepack pnpm test:runtime-isolation \u0026\u0026 corepack pnpm test:backup-integration",
    "test:e2e": "tsx scripts/stage10-browser-environment.ts test",
    "test:performance": "tsx scripts/stage10-performance.ts",
    "test:security": "tsx scripts/stage10-security.ts",
    "test:fixtures": "tsx scripts/stage10-fixture-check.ts",
    "validate:stage10": "tsx scripts/stage10-ci.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.2.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
