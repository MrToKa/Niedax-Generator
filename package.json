{
  "name": "niedax-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local modular Docker foundation for Niedax Generator",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "tsx scripts/compose.ts dev",
    "start": "tsx scripts/compose.ts start",
    "stop": "tsx scripts/compose.ts stop",
    "restart": "tsx scripts/compose.ts restart",
    "status": "tsx scripts/compose.ts status",
    "logs": "tsx scripts/compose.ts logs",
    "access:url": "tsx scripts/show-access-url.ts",
    "build": "corepack pnpm -r --if-present build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && corepack pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:containers": "tsx scripts/test-containers.ts",
    "test:runtime-isolation": "tsx scripts/verify-runtime-isolation.ts",
    "test:backup-integration": "tsx scripts/test-backup-integration.ts",
    "db:migrate": "tsx scripts/database-command.ts up",
    "db:status": "tsx scripts/database-command.ts status",
    "db:seed": "tsx scripts/database-command.ts seed",
    "db:test": "tsx scripts/db-check.ts",
    "db:reset:test": "tsx scripts/db-check.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:new": "tsx database/src/new-migration.ts",
    "user:create-admin": "tsx scripts/create-admin.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:list": "tsx scripts/backup.ts list",
    "backup:verify": "tsx scripts/backup.ts verify",
    "backup:restore": "tsx scripts/backup.ts restore",
    "backup:prune": "tsx scripts/backup.ts prune",
    "catalog:generate": "tsx scripts/generate-stage5-catalog.ts",
    "catalog:import": "tsx scripts/catalog-import.ts",
    "catalog:seed:dev": "docker compose exec backend node dist/catalog-seed.js",
    "validate": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:unit && corepack pnpm build",
    "validate:full": "corepack pnpm validate && corepack pnpm db:check && docker compose --profile tools build && corepack pnpm test:integration && corepack pnpm test:containers && corepack pnpm test:runtime-isolation && corepack pnpm test:backup-integration"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "26.2.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
